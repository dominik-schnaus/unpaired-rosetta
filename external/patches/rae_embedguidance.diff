+class GuidanceEmbedder(nn.Module):
+    """
+    Embeds continuous guidance vectors (e.g. a frozen vision model's embedding of the
+    image itself) instead of class labels. Handles dropout to a learned null embedding
+    for classifier-free guidance. No text or class information is involved.
+    """
+    def __init__(self, guidance_dim, hidden_size, dropout_prob):
+        super().__init__()
+        self.projection = nn.Sequential(
+            nn.Linear(guidance_dim, hidden_size),
+            nn.SiLU(),
+            nn.Linear(hidden_size, hidden_size),
+        )
+        self.null_embedding = nn.Parameter(torch.zeros(guidance_dim))
+        self.guidance_dim = guidance_dim
+        self.dropout_prob = dropout_prob
+
+    def token_drop(self, guidance, force_drop_ids=None):
+        """
+        Drops guidance vectors to enable classifier-free guidance.
+        """
+        if force_drop_ids is None:
+            drop_ids = torch.rand(guidance.shape[0], device=guidance.device) < self.dropout_prob
+        else:
+            drop_ids = force_drop_ids == 1
+        return torch.where(drop_ids[:, None], self.null_embedding.to(guidance.dtype), guidance)
+
+    def forward(self, guidance, train, force_drop_ids=None):
+        use_dropout = self.dropout_prob > 0
+        if (train and use_dropout) or (force_drop_ids is not None):
+            guidance = self.token_drop(guidance, force_drop_ids)
+        return self.projection(guidance)
